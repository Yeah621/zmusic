# Publik (aman di klien): hanya URL dan anon key Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia (server saja, jangan beri awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Audius: isi dengan Bearer Token dari api.audius.co/plans (server saja)
AUDIUS_API_KEY=
AUDIUS_APP_NAME=ZMusic
JAMENDO_CLIENT_ID=
# Bendera sumber musik. Jamendo dan Deezer hanya boleh untuk aplikasi non-komersial: matikan bila ada pemasukan.
ENABLE_AUDIUS=true
ENABLE_DEEZER=true
ENABLE_JAMENDO=true
