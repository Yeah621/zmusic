# Publik (aman di klien): hanya URL dan anon key Supabase (di dashboard: Project URL dan Publishable key). Lihat docs/supabase.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nama lama untuk kunci yang sama tetap didukung (diabaikan bila PUBLISHABLE_KEY terisi): NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia (server saja, jangan beri awalan NEXT_PUBLIC_): Secret key (service_role) di dashboard
SUPABASE_SERVICE_ROLE_KEY=
# Audius: isi dengan Bearer Token dari api.audius.co/plans (server saja)
AUDIUS_API_KEY=
AUDIUS_APP_NAME=ZMusic
JAMENDO_CLIENT_ID=
# Bendera sumber musik. Jamendo dan Deezer hanya boleh untuk aplikasi non-komersial: matikan bila ada pemasukan.
ENABLE_AUDIUS=true
ENABLE_DEEZER=true
ENABLE_JAMENDO=true
